^.*\.Rproj$
^\.Rproj\.user$
^.*\.Rcheck$
^.*\.tar\.gz$
^revdep$
^docs$
^doc$
^Meta$
^pkgdown$
^_pkgdown\.yml$
^cran-comments\.md$
^CRAN-SUBMISSION$
^\.lintr$
^\.github$
^CLAUDE\.md$
^Citation\.cff$
^\.claude$
^README\.Rmd$
^\.DS_Store$
^\.git$
^\.gitignore$
# httptest2 mirrors the full request URL into each fixture path, which runs
# past the 100 bytes a tarball can portably store. The replay tests therefore
# skip in R-CMD-check, which checks the built tarball; they run in the
# coverage job, which installs from the checkout where the fixtures exist
# (verified with a sentinel, not assumed).
^tests/testthat/_fixtures$
